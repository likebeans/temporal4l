{
  "name": "temporal-learning-demo",
  "version": "1.0.0",
  "private": true,
  "description": "通过可交互订单工作流学习 Temporal 的中文示例",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likebeans/temporal4l.git"
  },
  "homepage": "https://github.com/likebeans/temporal4l#readme",
  "bugs": {
    "url": "https://github.com/likebeans/temporal4l/issues"
  },
  "keywords": [
    "temporal",
    "workflow",
    "typescript",
    "learning",
    "durable-execution"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "worker:recovery": "tsx server/worker.ts",
    "dev:web": "vite --host 127.0.0.1",
    "temporal:local": "tsx scripts/temporal-local.ts",
    "temporal:up": "docker compose up -d --wait",
    "temporal:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages --outDir dist-pages",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1",
    "start": "concurrently --kill-others -n api,worker -c blue,magenta \"tsx server/index.ts\" \"tsx server/worker.ts\"",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/*.e2e.ts",
    "test:e2e:isolated": "tsx scripts/test-e2e.ts",
    "exercise:review": "tsx exercises/01-transfer/01.01-document-review/problem/main.ts",
    "exercise:review:solution": "tsx exercises/01-transfer/01.01-document-review/solution/main.ts",
    "test:exercise": "tsx --test tests/document-review*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "30.1.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
