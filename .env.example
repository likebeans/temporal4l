# Defaults are sufficient; copy to .env only when changing them.
# Docker: keep TEMPORAL_NAMESPACE aligned with compose.yaml's --namespace.
# temporal:local reads TEMPORAL_NAMESPACE from the same .env file.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=temporal-learning
TEMPORAL_UI_URL=http://localhost:8233
# API and Vite's /api proxy read this same port; restart both after changing it.
API_PORT=3001
# Optional: API and Worker must use the same payment ledger path.
# PAYMENT_DB_PATH=/absolute/path/to/payments.db
